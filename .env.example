# Copia este archivo a .env y pon valores reales antes de desplegar.
# NO subas el .env al repositorio.

DB_NAME=kioskpos
DB_ADMIN_USER=kioskpos_admin
DB_ADMIN_PASSWORD=CAMBIA-ESTA-CLAVE-FUERTE

# El usuario de runtime (sin privilegios). Pon una clave fuerte: al crear la BD en
# Docker se aplica sola (db/init/02-app-password.sh). Si la BD ya existía, cámbiala
# con ALTER ROLE (ver SEGURIDAD.md).
DB_APP_USER=kioskpos_app
DB_APP_PASSWORD=CAMBIA-ESTA-CLAVE-TAMBIEN

# Secreto para firmar los JWT: mínimo 32 bytes. Genera uno aleatorio.
# Genéralo con:  openssl rand -base64 48
KIOSKPOS_JWT_SECRET=pon-aqui-un-secreto-aleatorio-de-al-menos-32-bytes
# Solo mientras rotas la clave (ver SEGURIDAD.md). Normalmente vacío.
KIOSKPOS_JWT_SECRET_ANTERIOR=

# Bloqueo por intentos fallidos de PIN/clave.
KIOSKPOS_LOGIN_MAX_INTENTOS=5
KIOSKPOS_LOGIN_BLOQUEO_MINUTOS=15

# Respaldo diario fuera del servidor (opcional): remoto de rclone, ej. b2:kioskpos-respaldos
RCLONE_DESTINO=

# Primer super admin (uriel): se crea solo en el primer arranque si no existe.
# Quítalos luego del primer arranque exitoso.
KIOSKPOS_BOOTSTRAP_SUPERADMINEMAIL=uriel@kioskpos.com
KIOSKPOS_BOOTSTRAP_SUPERADMINPASSWORD=CAMBIA-ESTA-CLAVE

# Puerto público (solo si NO usas Caddy). Con Caddy, él toma 80/443.
WEB_PORT=80

# Dominio para el HTTPS automático de Caddy (debe apuntar a este servidor).
DOMAIN=kiospos.duckdns.org

# Avisos del servidor por Telegram (ops/monitor.sh, respaldos). Crea un bot con @BotFather,
# escríbele una vez y pon aquí su token y tu chat id. Vacío = solo queda en el log.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Correo transaccional (Resend por SMTP) ---
# Déjalo en false mientras no lo configures: la app funciona igual, solo no envía correos.
MAIL_ENABLED=false
# Resend: host fijo smtp.resend.com, usuario "resend", y la contraseña es tu API key de Resend.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=re_tu_api_key_de_resend
# Remitente. Antes de verificar tu dominio en Resend, usa onboarding@resend.dev.
# Con dominio verificado: "KioskPOS <no-reply@tudominio.com>".
MAIL_FROM=KioskPOS <onboarding@resend.dev>
# URL pública de tu app (para los enlaces de los correos).
MAIL_APP_URL=https://kiospos.duckdns.org
