server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  # Resuelve BACKEND_HOST en cada petición (no solo al arrancar nginx), con el DNS
  # real del contenedor (Docker embebido en local, el de Railway en la nube) — así si
  # el backend todavía no existía cuando arrancó nginx, igual funciona en cuanto exista.
  resolver ${RESOLVER} valid=10s;

  # La API va al backend. BACKEND_HOST por defecto es "backend:8080" (nombre del
  # servicio en docker-compose); en Railway se pone al nombre/puerto de ESE servicio
  # (ver RAILWAY.md).
  location /api/ {
    set $backend "${BACKEND_HOST}";
    proxy_pass http://$backend;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Salud del backend para el monitoreo (UptimeRobot, ops/monitor.sh). Solo esta ruta de /actuator.
  location = /actuator/health {
    set $backend "${BACKEND_HOST}";
    proxy_pass http://$backend;
  }

  # PWA: el service worker no se cachea para que siempre tome la última versión.
  location = /sw.js { add_header Cache-Control "no-cache"; }

  # SPA: cualquier ruta cae en index.html.
  location / {
    try_files $uri /index.html;
  }
}
